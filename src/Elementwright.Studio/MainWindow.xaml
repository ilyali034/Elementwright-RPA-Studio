<Window x:Class="Elementwright.Studio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Elementwright Studio"
        Width="1240"
        Height="800"
        MinWidth="960"
        MinHeight="640"
        Background="#0F141C"
        Foreground="#E6EDF7"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        ResizeMode="CanResize">

    <Grid Background="#0F141C">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <!-- Navigation -->
        <Border Grid.RowSpan="2"
                Background="#111821"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="18,18,18,22">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34" CornerRadius="9"
                                Background="#2C5D9B" VerticalAlignment="Center">
                            <TextBlock Text="E" FontSize="20" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="ELEMENTWRIGHT" FontSize="12"
                                       FontWeight="Bold" />
                            <TextBlock Text="AUTOMATION STUDIO" FontSize="8"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Margin="12"
                        Padding="11" Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="PROJECT STATUS" FontSize="9"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontWeight="Bold" />
                        <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="Local environment" FontSize="10" Margin="7,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="Elementwright · v0.1.0" FontSize="9"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0" />
                    </StackPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12,0">
                        <TextBlock Text="WORKSPACE" Foreground="{StaticResource MutedBrush}"
                                   FontSize="9" FontWeight="Bold" Margin="10,0,0,9" />
                        <ToggleButton Content="◈    Inspector"
                                      Style="{StaticResource NavigationToggleButton}"
                                      IsChecked="{Binding IsInspectorActive, Mode=OneWay}"
                                      Command="{Binding NavigateToInspectorCommand}" />
                        <ToggleButton Content="◇    Workflow Designer"
                                      Style="{StaticResource NavigationToggleButton}"
                                      IsChecked="{Binding IsWorkflowDesignerActive, Mode=OneWay}"
                                      Command="{Binding NavigateToWorkflowDesignerCommand}" />
                        <ToggleButton Content="▷    Runner"
                                      Style="{StaticResource NavigationToggleButton}"
                                      IsChecked="{Binding IsRunnerActive, Mode=OneWay}"
                                      Command="{Binding NavigateToRunnerCommand}" />

                        <TextBlock Text="DEVELOPMENT" Foreground="{StaticResource MutedBrush}"
                                   FontSize="9" FontWeight="Bold" Margin="10,24,0,9" />
                        <ToggleButton Content="⌘    Extensions"
                                      Style="{StaticResource NavigationToggleButton}"
                                      IsChecked="{Binding IsExtensionsActive, Mode=OneWay}"
                                      Command="{Binding NavigateToExtensionsCommand}" />
                        <ToggleButton Content="⚙    Settings"
                                      Style="{StaticResource NavigationToggleButton}"
                                      IsChecked="{Binding IsSettingsActive, Mode=OneWay}"
                                      Command="{Binding NavigateToSettingsCommand}" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Main content -->
        <Grid Grid.Column="1" Grid.Row="0">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ActiveSection}" Value="Workflow Designer">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ActiveSection}" Value="Runner">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ActiveSection}" Value="Extensions">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ActiveSection}" Value="Settings">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="66" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="25,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Application Inspector" FontSize="17"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Discover, inspect and target Windows applications"
                                   FontSize="10" Foreground="{StaticResource MutedBrush}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border Background="#1C2928" BorderBrush="#285448"
                                BorderThickness="1" CornerRadius="6"
                                Padding="9,6" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}"
                                         VerticalAlignment="Center" />
                                <TextBlock Text="ENGINE STANDBY" FontSize="9"
                                           Foreground="#8BD9BD" Margin="7,0,0,0" />
                            </StackPanel>
                        </Border>
                        <Button Content="↻  Refresh applications"
                                Command="{Binding RefreshApplicationsCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="24,22,24,22">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsInspecting}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,17">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Target applications" FontSize="14"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding DiscoveredCount, StringFormat={}{0} windows discovered}"
                                   FontSize="10" Foreground="{StaticResource MutedBrush}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <TextBox Grid.Column="1" Width="245" Height="34"
                             VerticalContentAlignment="Center"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Search by window title or process name" />
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.45*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="0.85*" />
                    </Grid.ColumnDefinitions>

                    <!-- Applications list -->
                    <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="43" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="58" />
                            </Grid.RowDefinitions>
                            <Border BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,0,0,1" Padding="15,0">
                                <Grid>
                                    <TextBlock Text="RUNNING APPLICATIONS" FontSize="9"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource MutedBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="WINDOW TITLE  /  PROCESS"
                                               FontSize="9" Foreground="{StaticResource MutedBrush}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding FilteredApplications}"
                                      SelectedItem="{Binding SelectedApplication}"
                                      IsReadOnly="True"
                                      Margin="0,1">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="WINDOW" Binding="{Binding WindowTitle}"
                                                        Width="*" />
                                    <DataGridTextColumn Header="PROCESS" Binding="{Binding ProcessName}"
                                                        Width="145" />
                                    <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}"
                                                        Width="75" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,1,0,0" Padding="14,0">
                                <Grid>
                                    <TextBlock Text="Select an application to inspect its details"
                                               FontSize="10" Foreground="{StaticResource MutedBrush}"
                                               VerticalAlignment="Center" />
                                    <Button Content="Connect to target  →"
                                            Command="{Binding ConnectToApplicationCommand}"
                                            Style="{StaticResource PrimaryButton}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Target details -->
                    <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="17">
                        <StackPanel>
                            <TextBlock Text="TARGET DETAILS" FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource MutedBrush}" />
                            <Border Height="1" Background="{StaticResource BorderBrush}"
                                    Margin="0,14,0,16" />
                            <Border Width="48" Height="48" CornerRadius="12"
                                    Background="#263B58" HorizontalAlignment="Left">
                                <TextBlock Text="▣" FontSize="23"
                                           Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding SelectedApplication.WindowTitle, TargetNullValue=No application selected}"
                                       FontSize="15" FontWeight="SemiBold"
                                       TextWrapping="Wrap" Margin="0,14,0,4" />
                            <TextBlock Text="{Binding SelectedApplication.ProcessName, TargetNullValue=Choose a window from the list}"
                                       FontSize="10" Foreground="{StaticResource MutedBrush}" />
                            <Border Height="1" Background="{StaticResource BorderBrush}"
                                    Margin="0,17,0,14" />
                            <TextBlock Text="PROCESS ID" FontSize="9"
                                       Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Text="{Binding SelectedApplication.ProcessId, TargetNullValue=—}"
                                       FontSize="12" Margin="0,5,0,13" />
                            <TextBlock Text="EXECUTABLE PATH" FontSize="9"
                                       Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Text="{Binding SelectedApplication.ExecutablePath, TargetNullValue=—}"
                                       FontSize="10" TextWrapping="Wrap"
                                       Margin="0,5,0,13" />
                            <TextBlock Text="WINDOW HANDLE" FontSize="9"
                                       Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Text="{Binding SelectedApplication.MainWindowHandle, TargetNullValue=—}"
                                       FontSize="10" Margin="0,5,0,0" />
                            <Border Background="#1A2635" CornerRadius="7"
                                    Padding="10" Margin="0,22,0,0">
                                <TextBlock Text="Press “Connect to target” to read the UI Automation tree of this window."
                                           TextWrapping="Wrap" FontSize="10"
                                           Foreground="#9CB5D5" />
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Element inspector -->
            <Grid Grid.Row="1" Margin="24,22,24,22">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsInspecting}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,17">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Content="←  Applications"
                            Command="{Binding BackToApplicationsCommand}" />
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ConnectedApplication.WindowTitle}"
                                   FontSize="14" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock FontSize="10" Foreground="{StaticResource MutedBrush}"
                                   Margin="0,4,0,0">
                            <Run Text="{Binding ConnectedApplication.ProcessName, Mode=OneWay}" />
                            <Run Text=" · PID " />
                            <Run Text="{Binding ConnectedApplication.ProcessId, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Refresh tree"
                                Command="{Binding RefreshTreeCommand}"
                                Margin="0,0,8,0" />
                        <Button Content="Test selector"
                                Command="{Binding TestSelectorCommand}"
                                Margin="0,0,8,0" />
                        <Button Content="Copy selector"
                                Command="{Binding CopySelectorCommand}"
                                Style="{StaticResource PrimaryButton}" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="0.8*" />
                    </Grid.ColumnDefinitions>

                    <!-- Element tree -->
                    <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="43" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,0,0,1" Padding="15,0">
                                <Grid>
                                    <TextBlock Text="UI ELEMENT TREE" FontSize="9" FontWeight="Bold"
                                               Foreground="{StaticResource MutedBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="CONTROL VIEW · LIVE SNAPSHOT" FontSize="8"
                                               Foreground="{StaticResource MutedBrush}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <TreeView Grid.Row="1"
                                      ItemsSource="{Binding RootElements}"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Padding="6"
                                      SelectedItemChanged="OnElementSelected">
                                <TreeView.Resources>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#263B58" />
                                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#263B58" />
                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF" />
                                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFFFFF" />
                                </TreeView.Resources>
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="IsExpanded" Value="True" />
                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                        <Setter Property="Padding" Value="2,3" />
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="11" />
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </Grid>
                    </Border>

                    <!-- Element properties -->
                    <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="17">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="ELEMENT PROPERTIES" FontSize="9" FontWeight="Bold"
                                           Foreground="{StaticResource MutedBrush}" />
                                <Border Height="1" Background="{StaticResource BorderBrush}"
                                        Margin="0,14,0,14" />

                                <TextBlock Text="CONTROL TYPE" FontSize="9" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock Text="{Binding SelectedElement.ControlType, TargetNullValue=—}"
                                           FontSize="12" Margin="0,5,0,13" />

                                <TextBlock Text="NAME" FontSize="9" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock Text="{Binding SelectedElement.Name, TargetNullValue=—}"
                                           FontSize="12" TextWrapping="Wrap" Margin="0,5,0,13" />

                                <TextBlock Text="AUTOMATION ID" FontSize="9" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock Text="{Binding SelectedElement.AutomationId, TargetNullValue=—}"
                                           FontSize="12" TextWrapping="Wrap" Margin="0,5,0,13" />

                                <TextBlock Text="CLASS NAME" FontSize="9" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock Text="{Binding SelectedElement.ClassName, TargetNullValue=—}"
                                           FontSize="12" TextWrapping="Wrap" Margin="0,5,0,13" />

                                <TextBlock Text="ENABLED" FontSize="9" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock Text="{Binding SelectedElement.IsEnabled, TargetNullValue=—}"
                                           FontSize="12" Margin="0,5,0,10" />
                                <TextBlock Text="OFFSCREEN" FontSize="9" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock Text="{Binding SelectedElement.IsOffscreen, TargetNullValue=—}"
                                           FontSize="12" Margin="0,5,0,10" />
                                <TextBlock Text="KEYBOARD FOCUSABLE" FontSize="9" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock Text="{Binding SelectedElement.IsKeyboardFocusable, TargetNullValue=—}"
                                           FontSize="12" Margin="0,5,0,10" />
                                <TextBlock Text="SUPPORTED PATTERNS" FontSize="9" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,5,0,12">
                                    <Run Text="Invoke: " />
                                    <Run Text="{Binding SelectedElement.HasInvokePattern}" />
                                    <Run Text="  ·  Value: " />
                                    <Run Text="{Binding SelectedElement.HasValuePattern}" />
                                    <Run Text="  ·  Toggle: " />
                                    <Run Text="{Binding SelectedElement.HasTogglePattern}" />
                                    <Run Text="  ·  Select: " />
                                    <Run Text="{Binding SelectedElement.HasSelectionItemPattern}" />
                                </TextBlock>
                                <TextBlock Text="HELP TEXT" FontSize="9" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock Text="{Binding SelectedElement.HelpText, TargetNullValue=—}"
                                           FontSize="11" TextWrapping="Wrap" Margin="0,5,0,12" />
                                <TextBlock Text="CURRENT VALUE" FontSize="9" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock Text="{Binding SelectedElement.Value, TargetNullValue=—}"
                                           FontSize="11" TextWrapping="Wrap" Margin="0,5,0,12" />

                                <TextBlock Text="BOUNDS" FontSize="9" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock FontSize="12" Margin="0,5,0,13">
                                    <Run Text="{Binding SelectedElement.X, Mode=OneWay, StringFormat=\{0:0\}}" />
                                    <Run Text=", " />
                                    <Run Text="{Binding SelectedElement.Y, Mode=OneWay, StringFormat=\{0:0\}}" />
                                    <Run Text="  ·  " />
                                    <Run Text="{Binding SelectedElement.Width, Mode=OneWay, StringFormat=\{0:0\}}" />
                                    <Run Text=" × " />
                                    <Run Text="{Binding SelectedElement.Height, Mode=OneWay, StringFormat=\{0:0\}}" />
                                </TextBlock>

                                <TextBlock Text="SELECTOR" FontSize="9" Foreground="{StaticResource MutedBrush}" />
                                <Border Background="#111720" CornerRadius="7" Padding="10" Margin="0,5,0,0">
                                    <TextBlock Text="{Binding SelectedElement.Selector, TargetNullValue=—}"
                                               FontFamily="Consolas" FontSize="10.5"
                                               TextWrapping="Wrap" Foreground="#9CB5D5" />
                                </Border>
                                <TextBlock Text="{Binding SelectorTestResult}" FontSize="10"
                                           TextWrapping="Wrap" Margin="0,10,0,14"
                                           Foreground="{StaticResource MutedBrush}" />
                                <TextBlock Text="SET VALUE" FontSize="9"
                                           Foreground="{StaticResource MutedBrush}" />
                                <TextBox Text="{Binding ValueInput, UpdateSourceTrigger=PropertyChanged}"
                                         MinHeight="34" Margin="0,6,0,8"
                                         VerticalContentAlignment="Center" />
                                <Button Content="Set value"
                                        Command="{Binding SetSelectedElementValueCommand}"
                                        HorizontalAlignment="Stretch" Margin="0,0,0,8" />
                                <Button Content="Invoke element"
                                        Command="{Binding InvokeSelectedElementCommand}"
                                        Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Stretch" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Content="Toggle"
                                            Command="{Binding ToggleSelectedElementCommand}" />
                                    <Button Grid.Column="2" Content="Select"
                                            Command="{Binding SelectSelectedElementCommand}" />
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- Workspace placeholder pages -->
        <Grid Grid.Column="1" Grid.Row="0" Background="#0F141C">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ActiveSection}" Value="Workflow Designer">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ActiveSection}" Value="Runner">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ActiveSection}" Value="Extensions">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ActiveSection}" Value="Settings">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="66" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <StackPanel Margin="25,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ActiveSection}" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="Elementwright automation workspace"
                               FontSize="10" Foreground="{StaticResource MutedBrush}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Grid Grid.Row="1" Margin="24">
                <Border Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="12"
                        Padding="28" MaxWidth="720" MaxHeight="260"
                        HorizontalAlignment="Left" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="{Binding ActiveSection}" FontSize="20"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="This workspace is not implemented yet."
                                   FontSize="13" Margin="0,12,0,6" />
                        <TextBlock Text="Navigation is active. The Inspector is the only workspace currently connected to the automation framework. Workflow Designer, Runner, Extensions and Settings will be added as functional modules rather than decorative screens."
                                   FontSize="11" Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap" MaxWidth="620" />
                        <Button Content="Open Inspector"
                                Command="{Binding NavigateToInspectorCommand}"
                                Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Left" Margin="0,20,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Column="1" Grid.Row="1"
                Background="#141922"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="15,0">
            <Grid>
                <TextBlock Text="{Binding StatusMessage}" FontSize="9"
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center" />
                <TextBlock Text="WPF  ·  .NET 10  ·  Windows"
                           FontSize="9" Foreground="{StaticResource MutedBrush}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
