<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Elementwright.Studio</RootNamespace>
    <AssemblyName>Elementwright.Studio</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <!--
    Framework подключается как библиотека.
    1) Если рядом лежит клон Elementwright-RPA-Framework — ссылка на проект (удобно при разработке).
    2) Иначе — NuGet-пакет Elementwright.Core.
  -->
  <PropertyGroup>
    <FrameworkCoreProject>$(MSBuildThisFileDirectory)..\..\..\Elementwright-RPA-Framework\src\Elementwright.Core\Elementwright.Core.csproj</FrameworkCoreProject>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(FrameworkCoreProject)')">
    <ProjectReference Include="$(FrameworkCoreProject)" />
  </ItemGroup>

  <ItemGroup Condition="!Exists('$(FrameworkCoreProject)')">
    <PackageReference Include="Elementwright.Core" Version="0.1.*" />
  </ItemGroup>

</Project>
